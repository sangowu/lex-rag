# 复制为 .env，填入真实值，不要提交到 git

# Embedding API 认证
EMBED_API_KEY=your-api-key-here

# Reranker API 认证。与 embedding 同一服务商时可以不填 —— 缺省回落到 EMBED_API_KEY
RERANK_API_KEY=

# 生成 / Judge / Contextual RAG / HyDE / multi-query 用的 LLM（DashScope，OpenAI 兼容）
GENERATE_MODEL_API=your-llm-api-key

# PostgreSQL 密码
PG_PASSWORD=your-db-password

# API 密钥，逗号分隔，多个 key 便于按调用方区分与单独吊销。
# 留空 = 不鉴权，只在本机开发时可接受：serve.py 会**拒绝启动**
# "--host 非回环地址 + 没有 API_KEYS" 这个组合，不让它变成一次静默的公开暴露。
# 生成一个：python -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
API_KEYS=

# MinerU 在线 API（OCR 脚本：eval_ocr / review_ocr / ingest_ocr）
# 在 https://mineru.net/apiManage 创建
MINERU_API_TOKEN=

# Langfuse 可观测性（可选）——三个变量都留空则完全 no-op，不影响主流程与 CI
# 在 https://cloud.langfuse.com 建项目后获取
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
